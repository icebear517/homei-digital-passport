# Local demo runs on localhost; NEVER use demo mode on a public host.
APP_MODE=demo
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/passport.sqlite

# For temporary phone preview only: APP_MODE=preview, localhost HOST,
# APP_ORIGIN=https://your-random-tunnel.trycloudflare.com,
# and a separate DATABASE_PATH. The browser prompts for username preview.
PREVIEW_PASSWORD=

# Set APP_MODE=production, HTTPS origin and these values before publishing.
LIFF_ID=
STAFF_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
# Required in production: a long random value used to sign every store QR entry URL.
ENTRY_SIGNING_SECRET=
# Coolify PostgreSQL internal URL. DATABASE_PATH is ignored when this is set.
DATABASE_URL=
# Google Form management workbook. The service account needs Viewer access only.
GOOGLE_SHEET_ID=1yVYi_vSx9F-2J9fEpWJnMEQuuRGNHUTn5YSH36AvGFA
# Prefer this Coolify-mounted secret file in production.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
# SHA-256 hashes of long random staff secrets, one key per merchant.
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Generate hash: node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" YOUR_SECRET
STAFF_CREDENTIALS_JSON={}
